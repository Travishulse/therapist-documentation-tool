#include <windows.h>

IDI_ICON1 ICON "app_icon.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Liz Wegner Proprietary Software Collective\0"
            VALUE "FileDescription",  "Clinical Documentation Companion\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "ClinicalDocumentationCompanion\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Liz Wegner Proprietary Software Collective\0"
            VALUE "OriginalFilename", "appTherapistDocumentationTool_Production.exe\0"
            VALUE "ProductName",      "Therapist Documentation Companion\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

